# Copier vers .env et adapter les secrets

POSTGRES_USER=forensic
POSTGRES_PASSWORD=
POSTGRES_DB=forensic

REDIS_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

TIMESKETCH_USER=admin
TIMESKETCH_PASSWORD=
TIMESKETCH_SECRET_KEY=

OPENCTI_ADMIN_EMAIL=admin@forensic.local
OPENCTI_ADMIN_PASSWORD=
OPENCTI_ADMIN_TOKEN=
OPENCTI_ENCRYPTION_KEY=
OPENCTI_HEALTHCHECK_ACCESS_KEY=

RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=opencti

MISP_ADMIN_EMAIL=admin@forensic.local
MISP_ADMIN_PASSWORD=
MISP_ADMIN_API_KEY=
MISP_PUBLIC_BASE_URL=

GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=
GRAFANA_DOMAIN=
GRAFANA_ALLOWED_ORIGINS=
GRAFANA_CSRF_ORIGINS=
GRAFANA_CORS_ORIGIN=
# Accès anonyme en lecture seule (dashboards embarqués). false = login exigé.
GRAFANA_ANONYMOUS_ENABLED=true
# lax par défaut ; mettre none uniquement si l'iframe Grafana est cross-site
GRAFANA_COOKIE_SAMESITE=lax

# ── OpenSearch ──
# Heap JVM par nœud (P-18 — adapter à la RAM hôte : 2g min, 4g recommandé)
OPENSEARCH_HEAP=2g
# Origine navigateur autorisée en CORS (P-03 — jamais *)
OPENSEARCH_CORS_ORIGIN=http://localhost:5601

# ── MISP / TheHive / Cortex (P-14 — secrets obligatoires) ──
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=misp
MYSQL_USER=misp
MYSQL_PASSWORD=
MISP_ENCRYPTION_KEY=
THEHIVE_SECRET=
THEHIVE_API_KEY=
THEHIVE_ADMIN_PASSWORD=
CORTEX_API_KEY=
CORTEX_SECRET=
CORTEX_ADMIN_PASSWORD=
# URLs internes des services CTI (routes /api/cti/* — rarement à changer)
# CORTEX_URL=http://cortex:9001
# MISP_URL=http://misp:80
# OPENCTI_URL=http://opencti:8080

# ── Images (P-13/P-20 — figer les tags en production, voir docs/VERSIONS.md) ──
# MINIO_IMAGE=minio/minio:RELEASE.2024-XX-XX
# MINIO_MC_IMAGE=minio/mc:RELEASE.2024-XX-XX
# TIMESKETCH_IMAGE=us-docker.pkg.dev/osdfir-registry/timesketch/timesketch:YYYYMMDD
# MISP_CORE_IMAGE=ghcr.io/misp/misp-docker/misp-core:v2.5.X
# GRAFANA_IMAGE=grafana/grafana-oss:10.4.3

UPLOAD_MAX_FILES=100
UPLOAD_MAX_SIZE_BYTES=5368709120
CERT_PORTAL_UPLOAD_MAX_SIZE=5368709120

# ── Portails CERT / IT (auth locale + JWT upload IT) ──
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=
CERT_PORTAL_SECRET=
IT_PORTAL_SECRET=
# Secret HMAC des sessions portail (P-14 — obligatoire en production)
PORTAL_SESSION_SECRET=
# URL du control-plane Sekoia (P-14)
SEKOIA_CONTROLPLANE_URL=http://sekoia-controlplane:8901
# Jeton interne partagé portail ↔ control-planes (en-tête X-Internal-Token).
# OBLIGATOIRE en production : sans lui, l'API /control/* est ouverte (mode lab).
# Générer : openssl rand -hex 32
INTERNAL_API_TOKEN=
# Clé Fernet de chiffrement des clés API Sekoia côté connecteur (WP-S1)
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SEKOIA_SECRETS_KEY=
# ── Monitoring Sekoia (sekoia-monitor) ──
SEKOIA_POLL_INTERVAL_S=60
SEKOIA_ALERT_INTERVAL_S=60
SEKOIA_SILENCE_MINUTES=60
SEKOIA_DROP_RATIO=0.5
SEKOIA_HOSTNAME_SILENCE_HOURS=24
# Webhook sortant pour les alertes d'ingestion (TheHive, Mattermost…), optionnel
SEKOIA_ALERT_WEBHOOK_URL=
# Automatisation CERT : créer un case TheHive par alerte d'ingestion (optionnel)
SEKOIA_AUTO_THEHIVE=false
SEKOIA_THEHIVE_URL=http://thehive:9000

CONNECTOR_MITRE_ID=a1b2c3d4-0001-0001-0001-mitre0000001
CONNECTOR_CVE_ID=a1b2c3d4-0001-0001-0001-cve000000001
CONNECTOR_OPENCTI_DATASETS_ID=a1b2c3d4-0001-0001-0001-datasets00001
CONNECTOR_CISA_KEV_ID=
CONNECTOR_THREATFOX_ID=
CONNECTOR_ABUSE_SSL_ID=
CONNECTOR_MITRE_ATLAS_ID=
CONNECTOR_DISARM_ID=
CONNECTOR_ALIENVAULT_ID=
CONNECTOR_ABUSEIPDB_ID=
CONNECTOR_SHODAN_ID=
CONNECTOR_IPINFO_ID=
CONNECTOR_URLHAUS_ID=
CONNECTOR_VXVAULT_ID=
CONNECTOR_MALWAREBAZAAR_ID=
CONNECTOR_APT_CAMPAIGN_ID=
CONNECTOR_EXPORT_REPORT_PDF_ID=be7208e6-4bd0-499d-9b26-c3fe54720428
CONNECTOR_EXPORT_FILE_STIX_ID=
CONNECTOR_EXPORT_FILE_CSV_ID=
CONNECTOR_EXPORT_FILE_TXT_ID=
CONNECTOR_IMPORT_FILE_STIX_ID=
CONNECTOR_IMPORT_DOCUMENT_ID=
CONNECTOR_DNS_TWIST_ID=

# Seuils ingestion massive (scripts/test_opencti_massive_ingest.sh)
OPENCTI_TI_MASSIVE_MIN_IND=700000
OPENCTI_TI_MASSIVE_MIN_OBS=700000
OPENCTI_TI_MASSIVE_MIN_STIX=1000000

ALIENVAULT_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
SHODAN_TOKEN=
IPINFO_TOKEN=
CYBER_MONITOR_GITHUB_TOKEN=
CYBER_MONITOR_FROM_YEAR=2020
CYBER_MONITOR_INTERVAL=7
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# ── Threat Platforms — control-plane connectors (collecte ciblée on-demand) ──
# Sekoia.IO : valeurs initiales seulement (secrets gérés ensuite via le panneau
# "Threat Platforms → Configuration", stockés chiffrés côté connecteur).
SEKOIA_API_KEY=
SEKOIA_UI_TOKEN=
SEKOIA_BASE_URL=https://app.sekoia.io
# PUBLIC_HOST : IP publique AWS (auto-détectée — accès https://<IP>/). Ne pas mettre 192.0.2.9.
PUBLIC_HOST=
# FP_ACCESS_MODE=ip : URLs, TLS et outils alignés sur l'IP (défaut). Redirige le DNS EC2 vers l'IP.
FP_ACCESS_MODE=ip
# PUBLIC_HOSTNAME : optionnel — domaine entreprise (proxy Palo Alto). Laisser vide pour IP seule.
PUBLIC_HOSTNAME=
# Identité publique du site (crawlers / demande recatégorisation Palo Alto)
FP_SITE_ORG_NAME="Cybercorp Forensic Platform"
FP_SITE_DESCRIPTION="Private SOC and digital forensics training laboratory for authorized cybersecurity teams."
FP_SITE_CONTACT_EMAIL=security@forensic.local
TIMESKETCH_EXTERNAL_URL=

SERVICES_HEALTH_CACHE_MS=20000

# ── Ports host (optionnel — éviter conflits avec autres stacks Docker) ──
# P-03 : seuls Nginx (80/443) et Logstash (5044/5045/5046/5140) sont exposés
# sur toutes les interfaces. Tous les autres ports sont bindés sur 127.0.0.1
# (accès local / scripts d'admin uniquement) — le trafic externe passe par Nginx.
# Défauts production : 80, 443, 9200, 5601, 5000, 9000, 9001
# Voir config/local-ports.env.example et scripts/detect-port-conflicts.sh
# FP_HTTP_PORT=80
# FP_HTTPS_PORT=443
# FP_OS_PORT=9200
# FP_OSD_PORT=5601
# FP_TIMESKETCH_PORT=5000
# FP_MINIO_PORT=9000
# FP_MINIO_CONSOLE_PORT=9001
# FP_OPENCTI_PORT=8080
# FP_MISP_PORT=8090
# FP_THEHIVE_PORT=9002
# FP_CORTEX_PORT=9003
# FP_GRAFANA_PORT=3001
# FP_PROMETHEUS_PORT=9090
# FP_CERT_PORTAL_PORT=3000
# FP_IT_PORTAL_PORT=3002
# FP_LOGSTASH_METRICS_PORT=

# ── HELK sidecar ──
HELK_ENABLED=true
HELK_ES_URL=http://helk-elasticsearch:9200
HELK_LOGSTASH_HTTP=http://helk-logstash:8080
HELK_BRIDGE_URL=http://helk-bridge:8095

# ── Velociraptor DFIR ──
VELOCIRAPTOR_ENABLED=true
VELOCIRAPTOR_ADMIN_USER=admin
VELOCIRAPTOR_ADMIN_PASSWORD=
VR_BRIDGE_URL=http://velociraptor-bridge:8097
VELOCIRAPTOR_API_URL=https://velociraptor-server:8002
