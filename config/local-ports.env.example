# Ports host alternatifs — copier vers config/local-ports.env (non versionné)
# Utiliser si 80/443/9200/etc. sont déjà pris par d'autres projets Docker.
# Ne stoppe aucun container externe : forensic-minimal bind sur ces ports à la place.

FP_HTTP_PORT=8080
FP_HTTPS_PORT=8443
FP_OS_PORT=9201
FP_OSD_PORT=5602
FP_TIMESKETCH_PORT=5001
FP_MINIO_PORT=9002
FP_MINIO_CONSOLE_PORT=9003
